# API Gateway (Service A)
GATEWAY_PORT=8080
GATEWAY_PROMPT_SERVICE_URL=
GATEWAY_GENERATION_SERVICE_URL=
GATEWAY_DATABASE_URL=
GATEWAY_REDIS_URL=
