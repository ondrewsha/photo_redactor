# Auth & Profile (Gateway)
GATEWAY_PUBLIC_BASE_URL=http
GATEWAY_FRONTEND_BASE_URL=htt
GATEWAY_COOKIE_SECURE=false
GATEWAY_COOKIE_DOMAIN=
