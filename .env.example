# Infrastructure
POSTGRES_DB=nanovisual
POSTGRES_USER=nanovisual
POSTGRES_PASSWORD=nanovisual

# Optional (for local tooling)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Prompt Service (Service B)
PROMPT_SERVICE_PORT=8001
PROMPT_SERVICE_LLM_PROVIDER=mock
PROMPT_SERVICE_INTERNAL_TOKEN=
PROMPT_SERVICE_OPENAI_API_KEY=
PROMPT_SERVICE_OPENAI_BASE_URL=https://api.openai.com/v1
PROMPT_SERVICE_OPENAI_MODEL=gpt-5-mini
PROMPT_SERVICE_OPENAI_PROXY_URL=
PROMPT_SERVICE_HTTP_TIMEOUT_S=30

# Generation Service (Service C)
GEN_SERVICE_PORT=8002
GEN_SERVICE_DATABASE_URL=
GEN_SERVICE_REDIS_URL=redis://redis:6379/0
GEN_SERVICE_QUEUE_KEY=
GEN_SERVICE_MEDIA_ROOT=/data/media
GEN_SERVICE_PUBLIC_BASE_URL=
GEN_SERVICE_IMAGE_PROVIDER=mock
GEN_SERVICE_GEMINI_API_KEY=
GEN_SERVICE_GEMINI_MODEL=gemini-2.5-flash-image # or imagen-4.0-generate-001 (requires billing)
GEN_SERVICE_GEMINI_PROXY_URL=

GEN_SERVICE_OPENAI_API_KEY=
GEN_SERVICE_OPENAI_BASE_URL=https://api.openai.com/v1
GEN_SERVICE_OPENAI_MODEL=gpt-image-1
GEN_SERVICE_OPENAI_PROXY_URL=
GEN_SERVICE_OPENAI_OUTPUT_FORMAT=png
GEN_SERVICE_OPENAI_QUALITY=standard
GEN_SERVICE_OPENAI_STYLE=

GEN_SERVICE_HTTP_TIMEOUT_S=60
GEN_SERVICE_INTERNAL_TOKEN=
GEN_SERVICE_WORKER_ENABLED=true
GEN_SERVICE_OUTPUT_ENABLED=true
GEN_SERVICE_OUTPUT_FORMAT=webp
GEN_SERVICE_OUTPUT_QUALITY=85
GEN_SERVICE_OUTPUT_MAX_SIDE=1280

# API Gateway (Service A)
GATEWAY_PORT=8080
GATEWAY_PROMPT_SERVICE_URL=http://prompt_service:8000
GATEWAY_GENERATION_SERVICE_URL=http://generation_service:8000
GATEWAY_DATABASE_URL=
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_INTERNAL_TOKEN=
GATEWAY_CORS_ALLOW_ORIGINS=http://localhost:5173
GATEWAY_HTTP_TIMEOUT_S=30
GATEWAY_DEBUG_ERRORS=false

# Auth & Profile (Gateway)
GATEWAY_PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_FRONTEND_BASE_URL=http://localhost:5173
GATEWAY_COOKIE_SECURE=false
GATEWAY_COOKIE_DOMAIN=
GATEWAY_JWT_SECRET=change-me
GATEWAY_JWT_TTL_MINUTES=20160

# SMTP (email verification)
GATEWAY_SMTP_HOST=
GATEWAY_SMTP_PORT=587
GATEWAY_SMTP_USERNAME=
GATEWAY_SMTP_PASSWORD=
GATEWAY_SMTP_FROM=
GATEWAY_SMTP_USE_TLS=true

# Google OAuth
GATEWAY_GOOGLE_CLIENT_ID=
GATEWAY_GOOGLE_CLIENT_SECRET=
GATEWAY_GOOGLE_REDIRECT_URL=

# Payments
GATEWAY_PAYMENT_PROVIDER=mock
GATEWAY_YOOKASSA_SHOP_ID=
GATEWAY_YOOKASSA_SECRET_KEY=
GATEWAY_YOOKASSA_RETURN_URL=
GATEWAY_YOOKASSA_WEBHOOK_SECRET=

# Anti-fraud
GATEWAY_ANTIFRAUD_REGISTER_IP_DAILY_LIMIT=5
GATEWAY_ANTIFRAUD_TRIAL_IP_DAILY_LIMIT=2
GATEWAY_ANTIFRAUD_TRIAL_DEVICE_LIMIT=1
